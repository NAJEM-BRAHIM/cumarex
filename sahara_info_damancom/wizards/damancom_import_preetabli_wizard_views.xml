<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_damancom_import_preetabli_wizard_form" model="ir.ui.view">
        <field name="name">damancom.import.preetabli.wizard.form</field>
        <field name="model">damancom.import.preetabli.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un fichier preetabli AFFEBDS">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Fichier preetabli CNSS (AFFEBDS_NNNNNNN_MMAAAA.txt)</strong>
                        <p class="mb-0">
                            Ce fichier est envoye chaque mois par la CNSS via le portail Damancom.
                            Telechargez-le depuis votre espace personnel Damancom et chargez-le ci-dessous.
                        </p>
                    </div>
                    
                    <group>
                        <field name="preetabli_file" 
                               filename="preetabli_filename"
                               widget="binary"/>
                        <field name="preetabli_filename" invisible="1"/>
                    </group>
                    
                    <group string="Apercu du fichier" invisible="not preview_num_affilie">
                        <group>
                            <field name="preview_num_affilie" readonly="1"/>
                            <field name="preview_periode" readonly="1"/>
                            <field name="preview_raison_sociale" readonly="1"/>
                            <field name="preview_identif_transfert" readonly="1"/>
                        </group>
                        <group>
                            <field name="preview_nbr_assures" readonly="1"/>
                            <field name="preview_total_af" readonly="1"/>
                            <field name="preview_date_emission" readonly="1"/>
                            <field name="preview_date_exigibilite" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Options d'importation">
                        <field name="create_new_declaration"/>
                        <field name="declaration_id" 
                               invisible="create_new_declaration"
                               required="not create_new_declaration"/>
                        <field name="auto_match_employees"/>
                        <field name="auto_load_payslips"/>
                    </group>
                    
                    <div class="alert alert-warning" role="alert" invisible="not preview_num_affilie">
                        <strong>Note importante</strong>
                        <p class="mb-0">
                            L'identifiant de transfert du preetabli sera 
                            recopie a l'identique dans le fichier BDS genere (champ B00).
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" 
                            string="Importer le Preetabli"
                            type="object" 
                            class="btn-primary"
                            invisible="not preetabli_file"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_damancom_import_preetabli_wizard" model="ir.actions.act_window">
        <field name="name">Importer Preetabli AFFEBDS</field>
        <field name="res_model">damancom.import.preetabli.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
