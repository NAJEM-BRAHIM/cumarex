<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_cnss" model="ir.ui.view">
        <field name="name">res.company.form.inherit.cnss</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CNSS Damancom" name="cnss_damancom">
                    <group>
                        <group string="Identification CNSS">
                            <field name="l10n_ma_cnss_num_affilie" placeholder="ex: 1773341"/>
                            <field name="l10n_ma_cnss_code_agence" placeholder="ex: 06"/>
                            <field name="l10n_ma_cnss_activite" placeholder="Activité déclarée à la CNSS"/>
                            <field name="l10n_ma_cnss_code_postal" placeholder="ex: 20100"/>
                        </group>
                        <group string="Information">
                            <div class="text-muted" colspan="2">
                                <p>
                                    Le <b>numéro d'affiliation CNSS</b> est validé selon
                                    l'algorithme officiel (cf cahier des charges CNSS).
                                </p>
                                <p>
                                    Ces informations sont utilisées dans les fichiers BDS
                                    générés pour Damancom (mode EDI).
                                </p>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
