<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             SALAIRE DE BASE
             ================================================================ -->

        <record id="ma_rule_salaire_base" model="hr.salary.rule">
            <field name="name">Salaire de Base</field>
            <field name="code">BASIC</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage * worked_days.WORK100.number_of_days / (worked_days.WORK100.number_of_days or 1) if worked_days.WORK100 else contract.wage</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             PRIME D'ANCIENNETÉ (5% / 10% / 15% / 20% / 25%)
             Calculée sur salaire de base + heures sup
             Code du Travail : Art. 350-356
             ================================================================ -->

        <record id="ma_rule_anciennete" model="hr.salary.rule">
            <field name="name">Prime d'Ancienneté</field>
            <field name="code">ANCIENNETE</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_anciennete_taux(payslip.date_to) > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
taux = contract.get_anciennete_taux(payslip.date_to)
result = BASIC * taux
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             HEURES SUPPLÉMENTAIRES
             Art. 196 du Code du Travail
             - 25% : entre 6h et 21h en semaine
             - 50% : entre 21h et 6h en semaine
             - 100% : jours de repos hebdo et fériés
             ================================================================ -->

        <record id="ma_rule_heures_supp_25" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 25%</field>
            <field name="code">HS25</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.HS25 and inputs.HS25.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Taux horaire = salaire de base / (191 heures conventionnelles)
taux_horaire = contract.wage / 191
result = inputs.HS25.amount * taux_horaire * 1.25
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_heures_supp_50" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 50%</field>
            <field name="code">HS50</field>
            <field name="sequence">31</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.HS50 and inputs.HS50.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
taux_horaire = contract.wage / 191
result = inputs.HS50.amount * taux_horaire * 1.50
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_heures_supp_100" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 100%</field>
            <field name="code">HS100</field>
            <field name="sequence">32</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.HS100 and inputs.HS100.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
taux_horaire = contract.wage / 191
result = inputs.HS100.amount * taux_horaire * 2.00
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             PRIMES DIVERSES
             ================================================================ -->

        <record id="ma_rule_prime_rendement" model="hr.salary.rule">
            <field name="name">Prime de Rendement</field>
            <field name="code">PRIME_REND</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.PRIME_REND and inputs.PRIME_REND.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.PRIME_REND.amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_prime_bilan" model="hr.salary.rule">
            <field name="name">Prime de Bilan / 13ème Mois</field>
            <field name="code">PRIME_BILAN</field>
            <field name="sequence">41</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.PRIME_BILAN and inputs.PRIME_BILAN.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.PRIME_BILAN.amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_prime_exceptionnelle" model="hr.salary.rule">
            <field name="name">Prime Exceptionnelle</field>
            <field name="code">PRIME_EXC</field>
            <field name="sequence">42</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = inputs.PRIME_EXC and inputs.PRIME_EXC.amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.PRIME_EXC.amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             INDEMNITÉS NON IMPOSABLES (jusqu'aux plafonds)
             ================================================================ -->

        <!-- Indemnité de transport : exonérée jusqu'à 500 DH/mois -->
        <record id="ma_rule_indemnite_transport" model="hr.salary.rule">
            <field name="name">Indemnité de Transport</field>
            <field name="code">IND_TRANSPORT</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.l10n_ma_indemnite_transport > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.l10n_ma_indemnite_transport</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- Indemnité de panier : exonérée jusqu'à 30 DH/jour, max 20% du brut -->
        <record id="ma_rule_indemnite_panier" model="hr.salary.rule">
            <field name="name">Indemnité de Panier</field>
            <field name="code">IND_PANIER</field>
            <field name="sequence">51</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.l10n_ma_indemnite_panier > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.l10n_ma_indemnite_panier</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- Indemnité de représentation : exonérée à 10% du salaire de base pour cadres -->
        <record id="ma_rule_indemnite_representation" model="hr.salary.rule">
            <field name="name">Indemnité de Représentation</field>
            <field name="code">IND_REPR</field>
            <field name="sequence">52</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.l10n_ma_indemnite_representation > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.l10n_ma_indemnite_representation</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             AVANTAGES EN NATURE (imposables et soumis CNSS)
             ================================================================ -->

        <record id="ma_rule_avantage_logement" model="hr.salary.rule">
            <field name="name">Avantage en Nature - Logement</field>
            <field name="code">AVN_LOGEMENT</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="ma_rule_category_avantage"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.l10n_ma_avantage_logement > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.l10n_ma_avantage_logement</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_avantage_voiture" model="hr.salary.rule">
            <field name="name">Avantage en Nature - Voiture</field>
            <field name="code">AVN_VOITURE</field>
            <field name="sequence">61</field>
            <field name="category_id" ref="ma_rule_category_avantage"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.l10n_ma_avantage_voiture > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.l10n_ma_avantage_voiture</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             SALAIRE BRUT GLOBAL (SBG)
             = Salaire de base + ancienneté + HS + primes + indemnités + avantages
             ================================================================ -->

        <record id="ma_rule_salaire_brut_global" model="hr.salary.rule">
            <field name="name">Salaire Brut Global (SBG)</field>
            <field name="code">SBG</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = (BASIC
          + (ANCIENNETE if 'ANCIENNETE' in locals() and ANCIENNETE else 0)
          + (HS25 if 'HS25' in locals() and HS25 else 0)
          + (HS50 if 'HS50' in locals() and HS50 else 0)
          + (HS100 if 'HS100' in locals() and HS100 else 0)
          + (PRIME_REND if 'PRIME_REND' in locals() and PRIME_REND else 0)
          + (PRIME_BILAN if 'PRIME_BILAN' in locals() and PRIME_BILAN else 0)
          + (PRIME_EXC if 'PRIME_EXC' in locals() and PRIME_EXC else 0)
          + (IND_TRANSPORT if 'IND_TRANSPORT' in locals() and IND_TRANSPORT else 0)
          + (IND_PANIER if 'IND_PANIER' in locals() and IND_PANIER else 0)
          + (IND_REPR if 'IND_REPR' in locals() and IND_REPR else 0)
          + (AVN_LOGEMENT if 'AVN_LOGEMENT' in locals() and AVN_LOGEMENT else 0)
          + (AVN_VOITURE if 'AVN_VOITURE' in locals() and AVN_VOITURE else 0))
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ================================================================
             SALAIRE BRUT IMPOSABLE (SBI)
             = SBG - exonérations (transport plafonné 500 DH, panier plafonné, etc.)
             ================================================================ -->

        <record id="ma_rule_salaire_brut_imposable" model="hr.salary.rule">
            <field name="name">Salaire Brut Imposable (SBI)</field>
            <field name="code">SBI</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Calcul des exonérations
exo_transport = min(contract.l10n_ma_indemnite_transport, 500.0)

# Indemnité de panier : exonérée jusqu'à 30 DH/jour ouvré (~ 22 jours = 660 DH max)
# limitée à 20% du SBG
jours_ouvres = 22  # standard mensuel
exo_panier_jours = min(contract.l10n_ma_indemnite_panier, 30.0 * jours_ouvres)
exo_panier_pct = SBG * 0.20
exo_panier = min(exo_panier_jours, exo_panier_pct)

# Représentation : exonérée à 10% du salaire de base
exo_repr = min(contract.l10n_ma_indemnite_representation, BASIC * 0.10)

total_exonerations = exo_transport + exo_panier + exo_repr
result = SBG - total_exonerations
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ================================================================
             SALAIRE BRUT SOUMIS À COTISATION SOCIALE (SBC)
             Pour CNSS : SBG - exonérations spécifiques CNSS
             En pratique = SBI dans la plupart des cas
             ================================================================ -->

        <record id="ma_rule_salaire_brut_cotisable" model="hr.salary.rule">
            <field name="name">Salaire Brut Cotisable (SBC)</field>
            <field name="code">SBC</field>
            <field name="sequence">115</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# CNSS : assiette = salaire brut hors indemnités à caractère de remboursement de frais
# (transport et panier dans les limites légales)
exo_transport = min(contract.l10n_ma_indemnite_transport, 500.0)
jours_ouvres = 22
exo_panier = min(contract.l10n_ma_indemnite_panier, 30.0 * jours_ouvres, SBG * 0.20)
result = SBG - exo_transport - exo_panier
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">False</field>
        </record>

    </data>
</odoo>
