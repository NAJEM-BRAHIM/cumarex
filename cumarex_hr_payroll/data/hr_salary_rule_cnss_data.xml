<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- CNSS Salariale : 4,48% plafonné à 6 000 DH -->
        <record id="ma_rule_cnss_sal" model="hr.salary.rule">
            <field name="name">CNSS - Part Salariale (4,48%)</field>
            <field name="code">CNSS_SAL</field>
            <field name="sequence">200</field>
            <field name="category_id" ref="ma_rule_category_cnss"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
PLAFOND_CNSS = 6000.0
assiette = min(SBC, PLAFOND_CNSS)
result = -(assiette * 0.0448)
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- CNSS Patronale : 8,98% plafonné à 6 000 DH -->
        <record id="ma_rule_cnss_pat" model="hr.salary.rule">
            <field name="name">CNSS - Prestations Sociales Patronale (8,98%)</field>
            <field name="code">CNSS_PAT</field>
            <field name="sequence">600</field>
            <field name="category_id" ref="ma_rule_category_patronal"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
PLAFOND_CNSS = 6000.0
assiette = min(SBC, PLAFOND_CNSS)
result = -(assiette * 0.0898)
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- Allocations Familiales : 6,40% déplafonné -->
        <record id="ma_rule_allocations_familiales" model="hr.salary.rule">
            <field name="name">Allocations Familiales (6,40% Patronale)</field>
            <field name="code">ALLOC_FAM</field>
            <field name="sequence">601</field>
            <field name="category_id" ref="ma_rule_category_patronal"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(SBC * 0.0640)</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- TFP : 1,60% déplafonné -->
        <record id="ma_rule_tfp" model="hr.salary.rule">
            <field name="name">Taxe Formation Professionnelle (1,60%)</field>
            <field name="code">TFP</field>
            <field name="sequence">602</field>
            <field name="category_id" ref="ma_rule_category_patronal"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(SBC * 0.0160)</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

    </data>
</odoo>
