        <!-- ================================================================
             SALAIRE BRUT GLOBAL (SBG)
             ================================================================ -->

        <record id="ma_rule_salaire_brut_global" model="hr.salary.rule">
            <field name="name">Salaire Brut Global (SBG)</field>
            <field name="code">SBG</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
def get_val(code):
    cat = categories.dict.get(code) if 'categories' in locals() else None
    return cat or 0

result = (BASIC
          + (locals().get('ANCIENNETE') or 0)
          + (locals().get('HS25') or 0)
          + (locals().get('HS50') or 0)
          + (locals().get('HS100') or 0)
          + (locals().get('PRIME_REND') or 0)
          + (locals().get('PRIME_BILAN') or 0)
          + (locals().get('PRIME_EXC') or 0)
          + (locals().get('IND_TRANSPORT') or 0)
          + (locals().get('IND_PANIER') or 0)
          + (locals().get('IND_REPR') or 0)
          + (locals().get('AVN_LOGEMENT') or 0)
          + (locals().get('AVN_VOITURE') or 0))
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             SALAIRE BRUT IMPOSABLE (SBI)
             ================================================================ -->

        <record id="ma_rule_salaire_brut_imposable" model="hr.salary.rule">
            <field name="name">Salaire Brut Imposable (SBI)</field>
            <field name="code">SBI</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
exo_transport = min(v.l10n_ma_indemnite_transport, 500.0) if v else 0
jours_ouvres = 22
exo_panier_jours = min(v.l10n_ma_indemnite_panier, 30.0 * jours_ouvres) if v else 0
exo_panier_pct = SBG * 0.20
exo_panier = min(exo_panier_jours, exo_panier_pct)
exo_repr = min(v.l10n_ma_indemnite_representation, BASIC * 0.10) if v else 0
total_exo = exo_transport + exo_panier + exo_repr
result = SBG - total_exo
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- ================================================================
             SALAIRE BRUT COTISABLE (SBC)
             ================================================================ -->

        <record id="ma_rule_salaire_brut_cotisable" model="hr.salary.rule">
            <field name="name">Salaire Brut Cotisable (SBC)</field>
            <field name="code">SBC</field>
            <field name="sequence">115</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
exo_transport = min(v.l10n_ma_indemnite_transport, 500.0) if v else 0
jours_ouvres = 22
exo_panier = min(v.l10n_ma_indemnite_panier, 30.0 * jours_ouvres, SBG * 0.20) if v else 0
result = SBG - exo_transport - exo_panier
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">False</field>
        </record>

    </data>
</odoo>
