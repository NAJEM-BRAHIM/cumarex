<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ma_rule_avance_salaire" model="hr.salary.rule">
            <field name="name">Avance sur Salaire</field>
            <field name="code">AVANCE</field>
            <field name="sequence">400</field>
            <field name="category_id" ref="ma_rule_category_retenue"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'AVANCE' in inputs and inputs['AVANCE'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -inputs['AVANCE'].amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

