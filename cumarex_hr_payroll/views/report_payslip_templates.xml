<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_cnss" inherit_id="hr_payroll.report_payslip" priority="16" name="Payslip Report CNSS">
        <xpath expr="//table[1]" position="before">
            <div t-if="o.employee_id.l10n_ma_cnss_num_imma" style="margin-bottom: 10px;">
                <strong>N° Immatriculation CNSS :</strong>
                <span t-esc="o.employee_id.l10n_ma_cnss_num_imma"/>
            </div>
        </xpath>
    </template>
</odoo>
