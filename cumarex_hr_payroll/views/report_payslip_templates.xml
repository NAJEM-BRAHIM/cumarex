<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_cnss" inherit_id="hr_payroll.report_payslip" priority="16" name="Payslip Report CNSS">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.employee_id.l10n_ma_cnss_num_imma">
                <div class="mb-2">
                    <strong>N° CNSS :</strong>
                    <span t-esc="o.employee_id.l10n_ma_cnss_num_imma"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
