<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Les champs Paie Maroc sont définis sur hr.version (contrat).
         Cette vue hérite de la vue formulaire hr.version pour les afficher
         dans l'onglet contrat de l'employé. -->

    <record id="hr_version_view_form_inherit_ma" model="ir.ui.view">
        <field name="name">hr.version.form.inherit.ma.sahara</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_version_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Paie Maroc"
                      name="page_paie_ma">
                    <group>
                        <group string="Ancienneté &amp; Famille">
                            <field name="l10n_ma_anciennete_date"/>
                            <field name="l10n_ma_personnes_charge"/>
                            <field name="l10n_ma_taux_frais_pro"/>
                            <field name="l10n_ma_calc_ir"/>
                            <field name="l10n_ma_calc_amo"/>
                        </group>
                        <group string="Indemnités Mensuelles (DH)">
                            <field name="l10n_ma_indemnite_transport"/>
                            <field name="l10n_ma_indemnite_panier"/>
                            <field name="l10n_ma_indemnite_representation"/>
                        </group>
                        <group string="Avantages en Nature (DH/mois)">
                            <field name="l10n_ma_avantage_logement"/>
                            <field name="l10n_ma_avantage_voiture"/>
                        </group>
                        <group string="CIMR (Retraite Complémentaire)">
                            <field name="l10n_ma_affilie_cimr"/>
                            <field name="l10n_ma_taux_cimr"
                                   invisible="not l10n_ma_affilie_cimr"/>
                            <field name="l10n_ma_taux_cimr_patronal"
                                   invisible="not l10n_ma_affilie_cimr"/>
                        </group>
                        <group string="Mutuelle (DH/mois)">
                            <field name="l10n_ma_mutuelle"/>
                            <field name="l10n_ma_mutuelle_patronal"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
