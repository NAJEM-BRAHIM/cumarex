<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_l10n_ma" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//td[@id='employee_infos']" position="inside">
            <div id="employee_cnss">
                <strong class="me-2">N° CNSS:</strong>
                <span t-esc="o.employee_id.l10n_ma_cnss_num_imma or ''"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@id,'working')]" position="replace"/>
    </template>
</odoo>
