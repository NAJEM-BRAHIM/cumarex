<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Catégories personnalisées Maroc - sans parent_id pour éviter tout
             conflit avec des XML IDs standard qui pourraient ne pas exister
             dans cette instance Odoo 19. -->

        <record id="ma_rule_category_brut" model="hr.salary.rule.category">
            <field name="name">Salaire Brut (MA)</field>
            <field name="code">BRUT_MA</field>
        </record>

        <record id="ma_rule_category_indemnite" model="hr.salary.rule.category">
            <field name="name">Indemnités (MA)</field>
            <field name="code">IND_MA</field>
        </record>

        <record id="ma_rule_category_avantage" model="hr.salary.rule.category">
            <field name="name">Avantages en Nature (MA)</field>
            <field name="code">AVN_MA</field>
        </record>

        <record id="ma_rule_category_cnss" model="hr.salary.rule.category">
            <field name="name">CNSS (MA)</field>
            <field name="code">CNSS_MA</field>
        </record>

        <record id="ma_rule_category_amo" model="hr.salary.rule.category">
            <field name="name">AMO (MA)</field>
            <field name="code">AMO_MA</field>
        </record>

        <record id="ma_rule_category_ir" model="hr.salary.rule.category">
            <field name="name">Impôt sur le Revenu (MA)</field>
            <field name="code">IR_MA</field>
        </record>

        <record id="ma_rule_category_retenue" model="hr.salary.rule.category">
            <field name="name">Retenues Diverses (MA)</field>
            <field name="code">RET_MA</field>
        </record>

        <record id="ma_rule_category_patronal" model="hr.salary.rule.category">
            <field name="name">Charges Patronales (MA)</field>
            <field name="code">PAT_MA</field>
        </record>

    </data>
</odoo>
