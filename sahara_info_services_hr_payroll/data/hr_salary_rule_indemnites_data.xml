        </record>

        <record id="ma_rule_avantage_voiture" model="hr.salary.rule">
            <field name="name">Avantage en Nature - Voiture</field>
            <field name="code">AVN_VOITURE</field>
            <field name="sequence">61</field>
            <field name="category_id" ref="ma_rule_category_avantage"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.version_id and payslip.version_id.l10n_ma_avantage_voiture > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.version_id.l10n_ma_avantage_voiture</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- SBG : calcul direct (Odoo 19 compatible) -->
        <record id="ma_rule_salaire_brut_global" model="hr.salary.rule">
            <field name="name">Salaire Brut Global (SBG)</field>
            <field name="code">SBG</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
ind_transport = v.l10n_ma_indemnite_transport if v else 0
ind_panier = v.l10n_ma_indemnite_panier if v else 0
ind_repr = v.l10n_ma_indemnite_representation if v else 0
avn_logement = v.l10n_ma_avantage_logement if v else 0
avn_voiture = v.l10n_ma_avantage_voiture if v else 0
taux_anc = v.get_anciennete_taux(payslip.date_to) if v else 0
anciennete = BASIC * taux_anc
wage = v.wage if v else 0
taux_horaire = wage / 191 if wage else 0
hs25 = inputs['HS25'].amount * taux_horaire * 1.25 if 'HS25' in inputs else 0
hs50 = inputs['HS50'].amount * taux_horaire * 1.50 if 'HS50' in inputs else 0
hs100 = inputs['HS100'].amount * taux_horaire * 2.00 if 'HS100' in inputs else 0
prime_rend = inputs['PRIME_REND'].amount if 'PRIME_REND' in inputs else 0
prime_bilan = inputs['PRIME_BILAN'].amount if 'PRIME_BILAN' in inputs else 0
prime_exc = inputs['PRIME_EXC'].amount if 'PRIME_EXC' in inputs else 0
result = (BASIC + anciennete + hs25 + hs50 + hs100
          + prime_rend + prime_bilan + prime_exc
          + ind_transport + ind_panier + ind_repr
          + avn_logement + avn_voiture)
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- SBI -->
        <record id="ma_rule_salaire_brut_imposable" model="hr.salary.rule">
            <field name="name">Salaire Brut Imposable (SBI)</field>
            <field name="code">SBI</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
exo_transport = min(v.l10n_ma_indemnite_transport, 500.0) if v else 0
exo_panier = min(v.l10n_ma_indemnite_panier, 660.0, SBG * 0.20) if v else 0
exo_repr = min(v.l10n_ma_indemnite_representation, BASIC * 0.10) if v else 0
result = SBG - exo_transport - exo_panier - exo_repr
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- SBC -->
        <record id="ma_rule_salaire_brut_cotisable" model="hr.salary.rule">
            <field name="name">Salaire Brut Cotisable (SBC)</field>
            <field name="code">SBC</field>
            <field name="sequence">115</field>
            <field name="category_id" ref="ma_rule_category_brut"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
exo_transport = min(v.l10n_ma_indemnite_transport, 500.0) if v else 0
exo_panier = min(v.l10n_ma_indemnite_panier, 660.0, SBG * 0.20) if v else 0
result = SBG - exo_transport - exo_panier
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
            <field name="appears_on_payslip">False</field>
        </record>

    </data>
</odoo>
