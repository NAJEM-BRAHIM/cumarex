<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- SALAIRE DE BASE -->
        <record id="ma_rule_salaire_base" model="hr.salary.rule">
            <field name="name">Salaire de Base</field>
            <field name="code">BASIC</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.version_id.wage if payslip.version_id else 0</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- PRIME D'ANCIENNETÉ (toujours calculée, retourne 0 si pas d'ancienneté) -->
        <record id="ma_rule_anciennete" model="hr.salary.rule">
            <field name="name">Prime d'Ancienneté</field>
            <field name="code">ANCIENNETE</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v = payslip.version_id
if v:
    taux = v.get_anciennete_taux(payslip.date_to)
    result = BASIC * taux if taux > 0 else 0.0
else:
    result = 0.0
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- HEURES SUPPLÉMENTAIRES (inputs as dict) -->
        <record id="ma_rule_heures_supp_25" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 25%</field>
            <field name="code">HS25</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'HS25' in inputs and inputs['HS25'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
wage = payslip.version_id.wage if payslip.version_id else 0
taux_horaire = wage / 191 if wage else 0
result = inputs['HS25'].amount * taux_horaire * 1.25
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_heures_supp_50" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 50%</field>
            <field name="code">HS50</field>
            <field name="sequence">31</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'HS50' in inputs and inputs['HS50'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
wage = payslip.version_id.wage if payslip.version_id else 0
taux_horaire = wage / 191 if wage else 0
result = inputs['HS50'].amount * taux_horaire * 1.50
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_heures_supp_100" model="hr.salary.rule">
            <field name="name">Heures Supplémentaires 100%</field>
            <field name="code">HS100</field>
            <field name="sequence">32</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'HS100' in inputs and inputs['HS100'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
wage = payslip.version_id.wage if payslip.version_id else 0
taux_horaire = wage / 191 if wage else 0
result = inputs['HS100'].amount * taux_horaire * 2.00
            </field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- PRIMES -->
        <record id="ma_rule_prime_rendement" model="hr.salary.rule">
            <field name="name">Prime de Rendement</field>
            <field name="code">PRIME_REND</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'PRIME_REND' in inputs and inputs['PRIME_REND'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs['PRIME_REND'].amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_prime_bilan" model="hr.salary.rule">
            <field name="name">Prime de Bilan / 13ème Mois</field>
            <field name="code">PRIME_BILAN</field>
            <field name="sequence">41</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'PRIME_BILAN' in inputs and inputs['PRIME_BILAN'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs['PRIME_BILAN'].amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_prime_exceptionnelle" model="hr.salary.rule">
            <field name="name">Prime Exceptionnelle</field>
            <field name="code">PRIME_EXC</field>
            <field name="sequence">42</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'PRIME_EXC' in inputs and inputs['PRIME_EXC'].amount > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs['PRIME_EXC'].amount</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <!-- INDEMNITÉS -->
        <record id="ma_rule_indemnite_transport" model="hr.salary.rule">
            <field name="name">Indemnité de Transport</field>
            <field name="code">IND_TRANSPORT</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="ma_rule_category_indemnite"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.version_id and payslip.version_id.l10n_ma_indemnite_transport > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.version_id.l10n_ma_indemnite_transport</field>
            <field name="struct_id" ref="hr_payroll_structure_ma_employee"/>
        </record>

        <record id="ma_rule_indemnite_panier" model="hr.salary.rule">
            <field name="name">Indemnité de Panier</field>
