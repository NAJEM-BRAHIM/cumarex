<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Note: en Odoo 19, les champs personnalisés peuvent être ajoutés
         soit à la vue hr.version, soit à la vue hr.employee qui affichera
         les valeurs selon la version active.
         Ici on hérite de la vue principale de l'employé. -->

    <record id="hr_employee_view_form_inherit_ma" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.ma.sahara_info_services</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Paie Maroc (Sahara Info Services)"
                      name="page_paie_ma_sahara_info_services">
                    <group>
                        <group string="Ancienneté &amp; Famille">
                            <field name="l10n_ma_anciennete_date"/>
                            <field name="l10n_ma_personnes_charge"/>
                            <field name="l10n_ma_ir_exonere"/>
                            <field name="l10n_ma_frais_pro_actif"/>
                            <field name="l10n_ma_taux_frais_pro"/>
                        </group>
                        <group string="Indemnités Mensuelles (DH)">
                            <field name="l10n_ma_indemnite_transport"/>
                            <field name="l10n_ma_indemnite_panier"/>
                            <field name="l10n_ma_indemnite_representation"/>
                        </group>
                        <group string="Avantages en Nature (DH/mois)">
                            <field name="l10n_ma_avantage_logement"/>
                            <field name="l10n_ma_avantage_voiture"/>
                        </group>
                        <group string="CIMR (Retraite Complémentaire)">
                            <field name="l10n_ma_affilie_cimr"/>
                            <field name="l10n_ma_taux_cimr"
                                   invisible="not l10n_ma_affilie_cimr"/>
                            <field name="l10n_ma_taux_cimr_patronal"
                                   invisible="not l10n_ma_affilie_cimr"/>
                        </group>
                        <group string="Mutuelle (DH/mois)">
                            <field name="l10n_ma_mutuelle"/>
                            <field name="l10n_ma_mutuelle_patronal"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
